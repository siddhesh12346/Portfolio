pipeline {
    agent any
    stages {
        stage('1. Checkout Code') {
            steps {
                checkout scm
            }
        }
        stage('2. Docker Build') {
            steps {
                script {
                    // Replace 'YOUR_ACTUAL_DOCKERHUB_USERNAME' with your real Docker Hub username
                    sh 'docker build -t siddheshk1234/portfolio:latest .'
                }
            }
        }
        stage('3. Push Image') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub-credentials', passwordVariable: 'DOCKER_PASSWORD', usernameVariable: 'DOCKER_USER')]) {
                    sh 'echo $DOCKER_PASSWORD | docker login -u $DOCKER_USER --password-stdin'
                    sh 'docker push siddheshk1234/portfolio:latest'
                }
            }
        }
        stage('4. Deploy to Minikube') {
            steps {
                sh 'kubectl apply -f k8s/'
            }
        }
    }
}
